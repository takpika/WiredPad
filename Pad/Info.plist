<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>WiredPad</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_wiredpad._tcp</string>
		<string>_wiredpad-pair._tcp</string>
	</array>
	<key>WiFiAwareServices</key>
	<dict>
		<key>_wiredpad._tcp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
		</dict>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>WiredPad uses Bluetooth to notice quickly when the iPad joins or leaves a Wi-Fi network.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>WiredPad uses the local network to connect your Mac and iPad over USB and Wi-Fi.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
