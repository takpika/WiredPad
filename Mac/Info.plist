<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>WiredPad Mac</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_wiredpad._tcp</string>
		<string>_wiredpad-pair._tcp</string>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 takpika</string>
	<key>NSIsTouchNative</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>WiredPad uses Bluetooth to notice quickly when the iPad joins or leaves a Wi-Fi network.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>WiredPad uses the local network to connect your Mac and iPad over USB and Wi-Fi.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>WiredPad captures its virtual display so it can show the image on your iPad.</string>
</dict>
</plist>
